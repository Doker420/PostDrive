# ── РУПОР: конфигурация. Скопируйте в .env и заполните. ──────────
# Секрет приложения (сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Публичный адрес сайта (для ссылок оплаты и вебхуков)
BASE_URL=http://localhost:8000
PORT=8000

# Экономика
COMMISSION_PCT=10
MIN_DEPOSIT_RUB=100
MAX_DEPOSIT_RUB=500000
USDT_RUB_RATE=95

# Админы (через запятую, первым критерием — первый зарегистрированный)
ADMIN_EMAILS=

# ── Платежи ──────────────────────────────────────────────────────
# CryptoBot (@CryptoBot → Crypto Pay → Create App)
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false

# xRocket Pay (pay.xrocket.eu)
XROCKET_TOKEN=
XROCKET_API_URL=https://pay.xrocket.eu/api

# ЮMoney (yoomoney.ru → Настройки → HTTP-уведомления)
YOOMONEY_PURSE=
YOOMONEY_SECRET=
# URL уведомлений: {BASE_URL}/pay/yoomoney/notify

# Активировать демо-режим принудительно (все оплаты виртуальные)
DEMO_PAYMENTS=false
